{
  "name": "genpayfrontend-wallet-app",
  "version": "0.1.0",
  "private": true,
  "description": "GenPayFrontend non-custodial crypto wallet base: React web, React Native mobile, shared TypeScript wallet logic, and TypeScript indexer/API.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "dev:mobile": "npm run start -w apps/mobile"
  },
  "keywords": [
    "wallet",
    "non-custodial",
    "crypto",
    "react",
    "react-native",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
